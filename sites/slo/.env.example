# PostgreSQL Credentials
POSTGRESS_HOST=sgi_postgres
POSTGRES_DB=sgi_db
POSTGRES_USER=sgi_user
POSTGRES_PASSWORD=your_secure_password_here

# The base URL for your application
API_HOST=api.yourdomain.com

# Optional: JWT secret for protecting ancestors / descendants / match-detail
# endpoints. Must match JWT_AUTH_SECRET_KEY in the WordPress wp-config.php.
# Leave unset to keep the API fully public. See README §7.
# Single-quote the value so $, #, ` and spaces survive docker-compose parsing.
# JWT_SECRET='paste-the-exact-wp-config-secret-here'

# Optional: the website's address, for the links MCP gives to each person.
# docker-compose.yml has this site's default.
# SITE_URL=https://indeks.example.org

# Optional: web pages allowed to call the API from a browser (comma-separated).
# docker-compose.yml has this site's default; empty allows any. Dev origins
# (localhost, LAN, Tailscale) are added automatically — see api.py.
# CORS_ORIGINS=https://indeks.example.org,https://gedmerge.com
